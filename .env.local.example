# ========================================
# UI ChatBotAul — Environment Configuration
# ========================================
# Copy this file to .env.local and fill in your values.
# cp .env.local.example .env.local
#
# Docs: https://github.com/your-repo/ui-chataul

# ========================================
# Server-Side API Key (shared key mode)
# ========================================
# Used when "Use Server API Key" toggle is ON in Settings,
# OR when NEXT_PUBLIC_LOCKED=true (forced server key mode).
# The client will NOT send an API key; the server uses this.
# Supports OpenAI & Anthropic (detected automatically).
#
# Get OpenAI key:    https://platform.openai.com/api-keys
# Get Anthropic key:  https://console.anthropic.com/keys
# Get OpenRouter key: https://openrouter.ai/keys
PROVIDER_API_KEY=

# ========================================
# Locked / Shared Mode (admin → members)
# ========================================
# Set to "true" to force server-side API key for all users.
# Hides API key & provider settings from the UI.
# Members can still adjust temperature, max tokens, system prompt.
# Use this for sharing the chatbot URL without exposing your API key.
# NEXT_PUBLIC_LOCKED=false

# ========================================
# Optional: Code Block Line Numbers
# ========================================
# Set to "true" to enable line numbers in code blocks.
# NEXT_PUBLIC_CODE_LINE_NUMBERS=false

# ========================================
# Optional: Debug Mode
# ========================================
# NEXT_PUBLIC_DEBUG=false

# ========================================
# Optional: Upstash Redis (shared rate limiting for serverless)
# ========================================
# Without these, rate limiting falls back to an in-memory per-instance
# limiter — fine for self-hosted single-node, weak on serverless (Vercel).
# With them, the sliding window is shared across ALL instances.
# Free tier: https://console.upstash.com → create a REST database.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
